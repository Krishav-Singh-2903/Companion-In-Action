# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Firebase Authentication
NEXT_PUBLIC_FIREBASE_API_KEY="replace-with-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="replace-with-firebase-auth-domain"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="replace-with-firebase-project-id"
NEXT_PUBLIC_FIREBASE_APP_ID="replace-with-firebase-app-id"

# Server-side Firebase Admin SDK
FIREBASE_PROJECT_ID="replace-with-firebase-project-id"
FIREBASE_CLIENT_EMAIL="replace-with-firebase-client-email"
FIREBASE_PRIVATE_KEY="replace-with-firebase-private-key"
